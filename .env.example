# Groq API key from your Groq Console. Leave empty until you configure chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Per-process in-memory limit; use a shared store before scaling to multiple workers.
CHAT_RATE_LIMIT=30
CHAT_RATE_WINDOW_SECONDS=60

# Optional path to a profile JSON file. Defaults to api/app/data/profile.json.
# PROFILE_PATH=
